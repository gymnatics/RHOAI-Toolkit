---
apiVersion: v1
kind: Secret
metadata:
  name: seaweedfs-s3-config
  labels:
    app.kubernetes.io/name: seaweedfs
    app.kubernetes.io/component: storage
stringData:
  s3.json: |
    {
      "identities": [
        {
          "name": "admin",
          "credentials": [
            {
              "accessKey": "${S3_ACCESS_KEY}",
              "secretKey": "${S3_SECRET_KEY}"
            }
          ],
          "actions": ["Admin", "Read", "Write", "List", "Tagging"]
        }
      ]
    }
