# LLMInferenceService template for llm-d model deployment (RHOAI 3.2+)
#
# Variables:
#   ${MODEL_NAME}       - Model deployment name
#   ${NAMESPACE}        - Target namespace
#   ${AUTH_ANNOTATION}  - "true" or "false" for auth
#   ${DISPLAY_NAME}     - Human-readable display name (openshift.io/display-name)
#   ${MODEL_URI}        - Model URI (oci://, hf://)
#   ${TOOL_PARSER}      - vLLM tool-call parser (e.g. hermes, llama3_json, mistral)
#   ${GPU_COUNT}        - Number of GPUs (limits + requests)
#   ${MEMORY_LIMIT}     - Memory limit (e.g. 16Gi)
#   ${MEMORY_REQUEST}   - Memory request (e.g. 8Gi)
#   ${CPU_LIMIT}        - CPU limit (e.g. '4')
#   ${CPU_REQUEST}      - CPU request (e.g. '2')
---
apiVersion: serving.kserve.io/v1alpha1
kind: LLMInferenceService
metadata:
  name: ${MODEL_NAME}
  namespace: ${NAMESPACE}
  labels:
    kueue.x-k8s.io/queue-name: default
    opendatahub.io/dashboard: "true"
    opendatahub.io/genai-asset: "true"
  annotations:
    security.opendatahub.io/enable-auth: "${AUTH_ANNOTATION}"
    openshift.io/display-name: "${DISPLAY_NAME}"
spec:
  replicas: 1
  model:
    uri: ${MODEL_URI}
    name: ${MODEL_NAME}
  router:
    route: {}
    gateway: {}
    scheduler: {}
  template:
    tolerations:
    - key: nvidia.com/gpu
      operator: Exists
      effect: NoSchedule
    containers:
    - name: main
      env:
        - name: VLLM_ADDITIONAL_ARGS
          value: "--enable-auto-tool-choice --tool-call-parser=${TOOL_PARSER}"
      resources:
        limits:
          cpu: '${CPU_LIMIT}'
          memory: ${MEMORY_LIMIT}
          nvidia.com/gpu: "${GPU_COUNT}"
        requests:
          cpu: '${CPU_REQUEST}'
          memory: ${MEMORY_REQUEST}
          nvidia.com/gpu: "${GPU_COUNT}"
