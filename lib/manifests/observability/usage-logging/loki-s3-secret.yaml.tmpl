# S3-compatible storage credentials for the Loki Operator (LokiStack
# spec.storage.secret). Backend-agnostic — works with SeaweedFS, Ceph RGW,
# or MinIO. Populated via envsubst from storage-backend.sh's
# get_storage_endpoint() + S3_ACCESS_KEY/S3_SECRET_KEY.
#
# LokiStack's secret schema differs from the RHOAI data-connection AWS_*
# format (access_key_id/access_key_secret/bucketnames/endpoint/region,
# lowercase, singular "endpoint" not "AWS_S3_ENDPOINT") -- this is Loki's
# own convention, not something we can unify with the AWS_* contract.
---
apiVersion: v1
kind: Secret
metadata:
  name: usage-logs-object-storage
  labels:
    app.kubernetes.io/name: usage-logging-storage
    app.kubernetes.io/component: storage
stringData:
  access_key_id: "${S3_ACCESS_KEY}"
  access_key_secret: "${S3_SECRET_KEY}"
  bucketnames: "${BUCKET_NAME}"
  endpoint: "${S3_ENDPOINT}"
  region: us-east-1
