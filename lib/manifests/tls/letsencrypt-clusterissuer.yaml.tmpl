apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-${ACME_ENV}
spec:
  acme:
    server: ${ACME_SERVER}
    email: ${ACME_EMAIL}
    privateKeySecretRef:
      name: letsencrypt-${ACME_ENV}-key
    solvers:
    - dns01:
        route53:
          region: ${AWS_REGION}
          accessKeyID: ${AWS_ACCESS_KEY_ID}
          hostedZoneID: ${ROUTE53_HOSTED_ZONE_ID}
          secretAccessKeySecretRef:
            name: route53-credentials
            key: secret-access-key
