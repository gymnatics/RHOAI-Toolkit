{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
  "description": "NVIDIA NIM Inference Metrics",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "title": "Tokens/Second",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(vllm:num_generation_tokens_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "tokens/s"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "title": "Time to First Token (P50)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(vllm:time_to_first_token_seconds_bucket{namespace=~\"$namespace\"}[5m])) by (le))",
          "legendFormat": "P50 TTFT"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "title": "GPU KV Cache Usage",
      "type": "stat",
      "targets": [
        {
          "expr": "avg(vllm:gpu_cache_usage_perc{namespace=~\"$namespace\"}) * 100",
          "legendFormat": "KV Cache %"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "title": "Active Requests",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(vllm:num_requests_running{namespace=~\"$namespace\"})",
          "legendFormat": "running"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 10,
      "title": "Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 11,
      "title": "Token Generation Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(vllm:num_generation_tokens_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "generation tokens/s"
        },
        {
          "expr": "sum(rate(vllm:num_prompt_tokens_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "prompt tokens/s"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 12,
      "title": "Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(vllm:request_success_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "success/s"
        },
        {
          "expr": "sum(rate(vllm:request_failure_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "failure/s"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 20,
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "id": 21,
      "title": "Time to First Token",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(vllm:time_to_first_token_seconds_bucket{namespace=~\"$namespace\"}[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(vllm:time_to_first_token_seconds_bucket{namespace=~\"$namespace\"}[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(vllm:time_to_first_token_seconds_bucket{namespace=~\"$namespace\"}[5m])) by (le))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "id": 22,
      "title": "End-to-End Request Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(vllm:e2e_request_latency_seconds_bucket{namespace=~\"$namespace\"}[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(vllm:e2e_request_latency_seconds_bucket{namespace=~\"$namespace\"}[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(vllm:e2e_request_latency_seconds_bucket{namespace=~\"$namespace\"}[5m])) by (le))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 30,
      "title": "GPU Resources",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "unit": "percent",
          "max": 100
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 31,
      "title": "GPU Utilization",
      "type": "timeseries",
      "targets": [
        {
          "expr": "avg(DCGM_FI_DEV_GPU_UTIL{namespace=~\"$namespace\"})",
          "legendFormat": "GPU Compute %"
        },
        {
          "expr": "avg(DCGM_FI_DEV_MEM_COPY_UTIL{namespace=~\"$namespace\"})",
          "legendFormat": "GPU Memory BW %"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 32,
      "title": "GPU Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "avg(DCGM_FI_DEV_FB_USED{namespace=~\"$namespace\"}) * 1024 * 1024",
          "legendFormat": "Used"
        },
        {
          "expr": "avg(DCGM_FI_DEV_FB_FREE{namespace=~\"$namespace\"}) * 1024 * 1024",
          "legendFormat": "Free"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 40,
      "title": "Queue & Scheduling",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "id": 41,
      "title": "Request Queue",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(vllm:num_requests_running{namespace=~\"$namespace\"})",
          "legendFormat": "running"
        },
        {
          "expr": "sum(vllm:num_requests_waiting{namespace=~\"$namespace\"})",
          "legendFormat": "waiting"
        },
        {
          "expr": "sum(vllm:num_requests_swapped{namespace=~\"$namespace\"})",
          "legendFormat": "swapped"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "percent",
          "max": 100
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "id": 42,
      "title": "KV Cache Utilization",
      "type": "timeseries",
      "targets": [
        {
          "expr": "avg(vllm:gpu_cache_usage_perc{namespace=~\"$namespace\"}) * 100",
          "legendFormat": "GPU KV Cache %"
        },
        {
          "expr": "avg(vllm:cpu_cache_usage_perc{namespace=~\"$namespace\"}) * 100",
          "legendFormat": "CPU KV Cache %"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "tags": ["nvidia", "nim", "inference", "gpu"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "nim-demo", "value": "nim-demo" },
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "namespace",
        "options": [],
        "query": "label_values(vllm:num_requests_running, namespace)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "NVIDIA NIM Inference",
  "uid": "nvidia-nim-inference",
  "version": 1
}
