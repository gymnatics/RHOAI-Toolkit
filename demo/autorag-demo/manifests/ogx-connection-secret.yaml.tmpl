# Dashboard connection to the AutoRAG OGX server. AutoRAG's pipeline reads OGX_CLIENT_BASE_URL and
# OGX_CLIENT_API_KEY from the secret named by ogx_secret_name, so creating it here saves the manual
# "Add connection" step. Rendered by deploy.sh with NAMESPACE, LLAMASTACK_URL.
apiVersion: v1
kind: Secret
metadata:
  name: autorag-ogx-connection
  namespace: ${NAMESPACE}
  labels:
    opendatahub.io/dashboard: "true"
    opendatahub.io/managed: "true"
  annotations:
    opendatahub.io/connection-type: ogx-stack
    openshift.io/display-name: "AutoRAG OGX Stack"
type: Opaque
stringData:
  OGX_CLIENT_BASE_URL: "${LLAMASTACK_URL}"
  OGX_CLIENT_API_KEY: "unused"
